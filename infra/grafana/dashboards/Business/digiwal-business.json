    {
      "id": 15,
      "type": "stat",
      "title": "Withdrawals that worked (all time)",
      "description": "Of the withdrawals that finished, the share that were completed rather than failed. Refused-up-front requests are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(digiwal_withdrawals_total{status=\"confirmed\"}) / (sum(digiwal_withdrawals_total{status=\"confirmed\"}) + sum(digiwal_withdrawals_total{status=\"failed\"}))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No data yet",
