    {
      "id": 17,
      "type": "timeseries",
      "title": "How long a withdrawal takes",
      "description": "Average time per completed withdrawal that day, split into our own work and the time the blockchain needs to confirm it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(digiwal_withdrawal_processing_seconds_sum[1d])) / sum(increase(digiwal_withdrawal_timed_total[1d]))",
          "legendFormat": "Our processing",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1d"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(digiwal_withdrawal_chain_wait_seconds_sum[1d])) / sum(increase(digiwal_withdrawal_timed_total[1d]))",
