          },
          "expr": "sum(increase(digiwal_withdrawals_total{status=\"confirmed\"}[1d])) / (sum(increase(digiwal_withdrawals_total{status=\"confirmed\"}[1d])) + sum(increase(digiwal_withdrawals_total{status=\"failed\"}[1d])))",
